{{!
    @template theme_rsmax/section_presentation

    The presentation of a module: a photo or a video with a text beside it, and «About this module».
    The theme moves it to the top of its section, whatever the format of the course.

    Example context (json):
    {
        "sectionid": 12, "hasmedia": true, "media": "", "mediakind": "", "placeholder": "Welcome video",
        "hasbrief": true, "heading": "Brief · Ana Lopez, CEO", "description": "<p>We need you.</p>",
        "transcript": "", "about": "<p>Objectives.</p>", "abouttitle": "About this module",
        "aboutsummary": "Objectives and project", "aboutbutton": "See objectives", "aboutclose": "Close"
    }
}}
<div class="rsx rsmax-pres" data-rsmax-presentation="{{sectionid}}">
    {{#hasmedia}}
    <div class="rsx-video rsmax-pres-media rsmax-pres-media--{{mediakind}}{{#placeholder}} rsx-video--maqueta{{/placeholder}}">
        {{{media}}}
        {{#placeholder}}
            <span>{{#str}} presentation:pending, theme_rsmax {{/str}}</span>
            <strong>{{placeholder}}</strong>
        {{/placeholder}}
    </div>
    {{/hasmedia}}
    {{#hasbrief}}
    <div class="rsx-brief rsmax-pres-brief">
        <div>
            {{#heading}}<p class="rsx-brief__who">{{heading}}</p>{{/heading}}
            {{#description}}<div class="rsmax-pres-text">{{{description}}}</div>{{/description}}
            {{#transcript}}
                <details class="rsmax-pres-transcript">
                    <summary>{{#str}} presentation:readfull, theme_rsmax {{/str}}</summary>
                    <div>{{{transcript}}}</div>
                </details>
            {{/transcript}}
        </div>
    </div>
    {{/hasbrief}}
    {{#about}}
    <details class="rsx-details rsx-sobre">
        <summary data-summary="{{aboutsummary}}" data-open="{{aboutbutton}}" data-close="{{aboutclose}}">{{abouttitle}}</summary>
        <div class="rsmax-pres-about">{{{about}}}</div>
    </details>
    {{/about}}
</div>
